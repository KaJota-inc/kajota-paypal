# ─────────────────────────────────────────────────────────────────────────────
# PayPal (sandbox for the hackathon window)
# ─────────────────────────────────────────────────────────────────────────────
# Get from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox                                       # sandbox | live
PAYPAL_WEBHOOK_ID=                                       # set after registering a webhook via the dashboard or /v1/notifications/webhooks

# PayPal Agent Toolkit — if the sandbox exposes an MCP server endpoint
# https://developer.paypal.com/tools/agents/quickstart/
PAYPAL_MCP_URL=                                          # e.g. https://mcp.sandbox.paypal.com

# ─────────────────────────────────────────────────────────────────────────────
# AP2 — Agent Payments Protocol (v0.2.0)
# https://ap2-protocol.org/ap2/payment_mandate/
# ─────────────────────────────────────────────────────────────────────────────
AP2_ISSUER_DID=                                          # DID that signs Payment Mandates in demo
AP2_ISSUER_PRIVATE_KEY=                                  # PEM / JWK; used only in sandbox stub-signing
AP2_VERIFY_SKEW_SECONDS=300                              # allowed clock skew on mandate verification

# ─────────────────────────────────────────────────────────────────────────────
# Channel3 (product discovery)
# https://docs.trychannel3.com/
# ─────────────────────────────────────────────────────────────────────────────
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.trychannel3.com/v1

# ─────────────────────────────────────────────────────────────────────────────
# OpenAI (agent runtime via Vercel AI SDK)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1                                     # or any model your account has

# ─────────────────────────────────────────────────────────────────────────────
# Arbitrum Sepolia (Kajota Mesh substrate chain)
# chainId = 421614
# ─────────────────────────────────────────────────────────────────────────────
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_EXPLORER_URL=https://sepolia.arbiscan.io

# EOA that calls release(depositId) on CosellEscrowV2 — must be registered as releaseAuth
MESH_RELEASE_AUTH_PRIVATE_KEY=

# EOA that holds PYUSD and submits deposit() on behalf of PayPal-settled orders
MESH_ORCHESTRATION_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_ID=421614
NEXT_PUBLIC_EXPLORER_URL=https://sepolia.arbiscan.io
